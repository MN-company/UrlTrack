# Server Configuration
SECRET_KEY=change_this_to_a_random_string_for_flask_sessions
SERVER_URL=https://your-app-name.pythonanywhere.com
API_KEY=your_secret_api_key_for_cli_access

# Cloudflare Turnstile (Captcha) - Get these from Cloudflare Dashboard
TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# AI Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
AI_PROMPT=You are a cybersecurity expert analyzing user agents and device fingerprints.

# OSINT & Proxy Tools
HOLEHE_CMD=holehe
WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE

# Security
# Set to 'True' to enable strict production security checks
PRODUCTION=True

# Proxy / Security Controls
# Trust X-Forwarded-For / X-Real-IP only if you run behind a proxy/load balancer
TRUST_PROXY_HEADERS=True
# Require signed visit tokens for public tracking endpoints
REQUIRE_VISIT_TOKEN=True
# Token TTL in seconds
VISIT_TOKEN_TTL_SECONDS=3600
# Disable credential capture by default (recommended)
ALLOW_CREDENTIAL_CAPTURE=False
# Disable partial email capture by default (recommended)
ALLOW_PARTIAL_EMAIL_CAPTURE=False
# Require consent before tracking
REQUIRE_CONSENT=False
# Consent cookie name + TTL (days)
CONSENT_COOKIE_NAME=ulrtrack_consent
CONSENT_TTL_DAYS=180
# Anonymize stored IP addresses (still uses raw IP for geo/security checks)
ANONYMIZE_IP=False
# Auto-delete visits older than N days (0 = disable)
VISIT_RETENTION_DAYS=0
# Malicious IP list refresh interval (seconds) and minimum valid IPs
MALICIOUS_IP_REFRESH_SECONDS=21600
MALICIOUS_IP_MIN_COUNT=1000
# Lock down custom HTML pages with a restrictive CSP
CUSTOM_HTML_LOCKDOWN=False
# Enable strict CSP with nonces for templates
CSP_STRICT=False
